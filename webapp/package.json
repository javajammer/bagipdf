{
  "name": "bagipdf",
  "version": "2.0.0",
  "type": "module",
  "description": "BagiPDF - High Performance Portable Windows PDF Suite powered by Rust & Tauri by Franky Setiawan",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.bagipdf.app",
    "productName": "BagiPDF",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "../dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "publisherName": "Franky Setiawan",
      "icon": "public/vite.svg"
    },
    "portable": {
      "artifactName": "BagiPDF-v${version}.exe"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2",
    "vite": "^6.4.3"
  }
}
