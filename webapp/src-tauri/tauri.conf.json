{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BagiPDF",
  "version": "2.0.0",
  "identifier": "com.bagipdf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BagiPDF",
        "width": 1200,
        "height": 800,
        "minWidth": 950,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "portable"],
    "publisher": "Franky Setiawan",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
