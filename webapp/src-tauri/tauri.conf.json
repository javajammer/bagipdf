{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BagiPDF",
  "version": "2.1.1",
  "identifier": "com.bagipdf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BagiPDF",
        "width": 1200,
        "height": 800,
        "minWidth": 950,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0 | libgtk-3-0t64",
          "libappindicator3-1 | libayatana-appindicator3-1",
          "librsvg2-2",
          "libsoup-3.0-0 | libsoup2.4-1",
          "libc6"
        ]
      }
    },
    "publisher": "Muhammad Fahrizal Rahman",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
